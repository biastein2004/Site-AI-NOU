/* ========== Reset și variabile ========== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --teal:#2A9D8F;--teal-dark:#21867A;--blue:#457B9D;--yellow:#E9C46A;
  --free:#2ECC71;--busy:#E74C3C;--bg:#F8F9FA;--white:#fff;--text:#212529;--red:#C0392B;
  --radius:16px;--radius-sm:12px;
  --shadow:0 2px 6px rgba(33,37,41,.06),0 8px 20px rgba(33,37,41,.08);
  --shadow-lg:0 6px 12px rgba(33,37,41,.08),0 18px 36px rgba(33,37,41,.14);
}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;line-height:1.7;color:var(--text);background:var(--bg)}
ul{list-style:none}a{color:inherit;text-decoration:none}
h1,h2,h3{font-weight:700;line-height:1.2}
p{margin-bottom:1em}
:focus-visible{outline:3px solid var(--yellow);outline-offset:3px;box-shadow:0 0 0 6px rgba(42,157,143,.35)}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.container{width:100%;max-width:1160px;margin:0 auto;padding:0 24px}
.section{padding:88px 0}.section-white{background:var(--white)}
.section-title,h2{font-size:2.1rem;margin-bottom:.6em}.section-title{text-align:center;margin-bottom:2.2rem}
h3{font-size:1.15rem;margin-bottom:.4em}
.grid{display:flex;flex-wrap:wrap;gap:24px}.grid-4>*{flex:1 1 230px}
.note{text-align:center;font-size:.9rem;margin:2rem 0 0}.hint{text-align:center;font-size:.85rem;margin:1.5rem 0 0}

/* ========== Butoane ========== */
.btn{display:inline-block;padding:12px 26px;font:inherit;font-weight:600;color:var(--white);background:var(--teal);border:2px solid var(--teal);border-radius:999px;cursor:pointer;text-align:center;transition:transform .25s,box-shadow .25s,background .25s,color .25s}
.btn:hover{background:var(--teal-dark);border-color:var(--teal-dark);transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.btn-outline{background:transparent;color:var(--teal)}.btn-outline:hover{color:var(--white)}
.btn-outline-dark{background:transparent;color:var(--teal-dark)}.btn-outline-dark:hover{color:var(--white)}
.btn-small{padding:8px 18px;font-size:.9rem}
.btn-urgent{background:var(--red);border-color:var(--red);padding:10px 18px;font-size:.9rem}
.btn-urgent:hover{background:#A93226;border-color:#A93226}

/* ========== Header ========== */
.site-header{position:sticky;top:0;z-index:50;background:var(--white);box-shadow:var(--shadow)}
.header-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:12px;padding-bottom:12px;position:relative}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:1.25rem;color:var(--teal-dark)}
.logo span{display:flex;flex-direction:column;line-height:1.1}.logo small{font-size:.72rem;font-weight:500;color:var(--blue)}
.logo-mark{width:42px;height:42px}
.nav{display:flex;align-items:center;gap:24px}.nav-list{display:flex;gap:22px}
.nav-list a{font-weight:500;padding:4px 0;background:linear-gradient(var(--teal),var(--teal)) 0 100%/0 3px no-repeat;transition:background-size .3s,color .3s}
.nav-list a:hover{color:var(--teal-dark);background-size:100% 3px}
.nav-toggle{display:none;font-size:1.6rem;background:none;border:0;color:var(--teal-dark);cursor:pointer}

/* ========== Hero ========== */
.hero{padding:80px 0;background:linear-gradient(135deg,#E3F4F1,#EAF2F8)}
.hero-inner{display:flex;align-items:center;gap:56px}.hero-text{flex:1.1}
.hero h1{font-size:2.9rem;color:var(--teal-dark);margin-bottom:.5em}
.hero-text p{font-size:1.12rem;max-width:50ch}
.hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:1.5rem}
.hero-visual{flex:1;position:relative;min-height:380px}
.visual-main{position:absolute;inset:20px 30px 30px 20px;background:var(--teal);border-radius:28px;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:8rem;box-shadow:var(--shadow-lg)}
.visual-main img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.float-card{position:absolute;background:var(--white);padding:10px 18px;border-radius:var(--radius-sm);box-shadow:var(--shadow-lg);font-size:.9rem}
.float-card strong{color:var(--teal-dark)}
.fc-1{top:0;right:0;border-left:5px solid var(--red)}.fc-2{bottom:0;left:0;border-left:5px solid var(--yellow)}.fc-3{bottom:60px;right:-8px;border-left:5px solid var(--blue)}

/* ========== Echipa ========== */
.member{background:var(--white);padding:30px 22px;border-radius:var(--radius);box-shadow:var(--shadow);text-align:center;transition:transform .3s,box-shadow .3s}
.member:hover,.pkg:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
.portrait{position:relative;overflow:hidden;width:96px;height:96px;margin:0 auto 14px;border-radius:50%;background:var(--teal);color:var(--white);font-weight:700;font-size:1.6rem;display:flex;align-items:center;justify-content:center;border:4px solid var(--yellow)}
.portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.spec{color:var(--blue);font-weight:600;margin-bottom:.5em}.member p:last-child{margin:0;font-size:.92rem}

/* ========== Galerie ========== */
.gallery{display:flex;flex-wrap:wrap;gap:16px}
.photo{position:relative;flex:1 1 220px;min-height:200px;border-radius:var(--radius);overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:4.2rem;box-shadow:var(--shadow);transition:transform .3s,box-shadow .3s}
.photo.tall{min-height:300px;flex-grow:1.4}
.photo:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.g1{background:#cfe9e5}.g2{background:#EAF2F8}.g3{background:#fbefc9}.g4{background:#dfe9f5}.g5{background:#e3f4f1}.g6{background:#f3ecd2}
.photo figcaption{position:absolute;left:0;right:0;bottom:0;z-index:1;padding:10px 16px;font-size:.9rem;font-weight:500;color:var(--white);background:linear-gradient(transparent,rgba(33,37,41,.75))}

/* ========== Pachete ========== */
.packages{display:flex;flex-wrap:wrap;gap:24px;justify-content:center}
.pkg{position:relative;flex:1 1 300px;max-width:360px;display:flex;flex-direction:column;background:var(--white);border-top:6px solid var(--blue);border-radius:var(--radius);padding:34px 26px;box-shadow:var(--shadow);transition:transform .3s,box-shadow .3s}
.pkg.top{border-top-color:var(--teal)}
.badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--yellow);font-weight:600;font-size:.82rem;padding:4px 16px;border-radius:999px;white-space:nowrap}
.price{font-size:2rem;font-weight:700;color:var(--teal-dark)}
.pkg ul{flex:1;margin-bottom:1.4rem}.pkg li{padding:7px 0;border-bottom:1px solid #E5E8EB}
.pkg li::before{content:"✓ ";color:var(--teal);font-weight:700}

/* ========== Programare ========== */
.booking{display:flex;gap:32px;align-items:flex-start}
.booking-form,.slots-panel{background:var(--bg);padding:32px;border-radius:var(--radius);box-shadow:var(--shadow)}
.booking-form{flex:1}.slots-panel{flex:1.2}
.form-group{display:flex;flex-direction:column;gap:6px;margin-bottom:16px}.form-group label{font-weight:600;font-size:.9rem}
input,select{width:100%;font:inherit;color:var(--text);background:var(--white);padding:12px 14px;border:2px solid #CED4DA;border-radius:var(--radius-sm)}
input:focus-visible,select:focus-visible{border-color:var(--teal)}
.form-status{margin:12px 0 0;font-weight:600;color:var(--teal-dark)}.form-status.err{color:var(--busy)}.form-status.light{color:var(--yellow)}
.days{display:flex;flex-wrap:wrap;gap:8px;margin:.4rem 0 1.4rem}
.day{flex:1 1 56px;display:flex;flex-direction:column;align-items:center;font:inherit;font-size:.8rem;padding:8px 0;background:var(--white);border:2px solid #CED4DA;border-radius:var(--radius-sm);cursor:pointer;text-transform:capitalize;transition:transform .2s,border-color .2s}
.day b{font-size:1.1rem}.day:hover{transform:translateY(-3px)}
.day.on{background:var(--teal);color:var(--white);border-color:var(--teal)}
.legend{display:flex;gap:18px;font-size:.88rem;margin:.5rem 0 1rem}.legend li{display:flex;align-items:center;gap:6px}
.sw{width:14px;height:14px;border-radius:4px;display:inline-block}.sw.free{background:var(--free)}.sw.busy{background:var(--busy)}.sw.sel{background:var(--yellow)}
.slots{display:flex;flex-wrap:wrap;gap:10px}
.slot{flex:1 1 76px;font:inherit;font-weight:600;padding:10px 0;border-radius:var(--radius-sm);border:2px solid transparent;color:var(--text);cursor:pointer;transition:transform .2s,box-shadow .2s}
.slot.free{background:var(--free)}.slot.free:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.slot.sel{background:var(--yellow);border-color:var(--teal-dark)}
.slot.busy{background:var(--busy);color:var(--white);opacity:.55;cursor:not-allowed;text-decoration:line-through}
.bar-label{font-size:.88rem;margin:14px 0 0}

/* ========== Locație ========== */
.location{display:flex;gap:48px;align-items:center}.location-info{flex:1}
.facts li{padding:12px 16px;margin-bottom:12px;background:var(--white);border-left:5px solid var(--yellow);border-radius:var(--radius-sm);box-shadow:var(--shadow)}
.map{flex:1;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-lg)}.map svg{display:block;width:100%;height:auto}

/* ========== Footer ========== */
.site-footer{background:var(--text);color:#DEE2E6;padding:60px 0 24px}
.footer-grid{display:flex;flex-wrap:wrap;gap:40px}.footer-grid>div{flex:1 1 220px}
.site-footer h3{color:var(--yellow)}.site-footer li{margin-bottom:.4em}.site-footer a:hover{color:var(--yellow)}
.newsletter{display:flex;flex-direction:column;gap:10px}
.social-hub{margin-top:36px;padding-top:24px;border-top:1px solid rgba(255,255,255,.15)}
.social{display:flex;flex-wrap:wrap;gap:12px;margin-top:10px}
.social a{display:inline-block;padding:8px 20px;border:2px solid var(--yellow);border-radius:999px;font-weight:600;transition:background .2s,color .2s}
.social a:hover{background:var(--yellow);color:var(--text)}
.copyright{text-align:center;margin:32px 0 0;font-size:.9rem}

/* ========== Tablete ≤1024px ========== */
@media (max-width:1024px){.hero h1{font-size:2.5rem}.booking,.location{flex-direction:column;align-items:stretch}.nav,.nav-list{gap:14px}}

/* ========== Mobil ≤768px ========== */
@media (max-width:768px){
  .section{padding:60px 0}
  .nav-toggle{display:block}
  .nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;padding:20px 24px;background:var(--white);box-shadow:var(--shadow)}
  .nav.open{display:flex}.nav-list{flex-direction:column;gap:12px}
  .hero{padding:48px 0}.hero-inner{flex-direction:column;gap:36px}.hero h1{font-size:2.1rem}
  .hero-visual{width:100%;min-height:300px}.visual-main{font-size:6rem}
  .booking-form,.slots-panel{padding:22px}
  .section-title,h2{font-size:1.7rem}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
